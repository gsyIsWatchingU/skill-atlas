[program:skill-atlas]
command=/workspace/projects/skill-atlas/current/deploy/start.sh
directory=/workspace/projects/skill-atlas/current
environment=SKILL_ATLAS_STATE_ROOT="/workspace/projects/skill-atlas",TZ="Asia/Shanghai"
autostart=true
autorestart=true
startsecs=5
stopasgroup=true
killasgroup=true
priority=45
stdout_logfile=/workspace/projects/skill-atlas/logs/supervisor-app.out.log
stderr_logfile=/workspace/projects/skill-atlas/logs/supervisor-app.err.log
stdout_logfile_maxbytes=10MB
stderr_logfile_maxbytes=10MB
stdout_logfile_backups=3
stderr_logfile_backups=3
