[program:skill-atlas]
command=/workspace/projects/skill-atlas/current/deploy/start.sh
directory=/workspace/projects/skill-atlas/current
environment=SKILL_ATLAS_STATE_ROOT="/workspace/projects/skill-atlas",TZ="Asia/Shanghai"
autostart=true
autorestart=true
startsecs=5
stopasgroup=true
killasgroup=true
priority=45
stdout_logfile=/workspace/projects/skill-atlas/logs/supervisor-app.out.log
stderr_logfile=/workspace/projects/skill-atlas/logs/supervisor-app.err.log
stdout_logfile_maxbytes=10MB
stderr_logfile_maxbytes=10MB
stdout_logfile_backups=3
stderr_logfile_backups=3

[program:cloudflared-skill-atlas]
command=/workspace/.tools/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8787
directory=/workspace/projects/skill-atlas
environment=TZ="Asia/Shanghai"
autostart=true
autorestart=true
startsecs=10
startretries=10
stopasgroup=true
killasgroup=true
priority=55
stdout_logfile=/workspace/projects/skill-atlas/logs/cloudflared.out.log
stderr_logfile=/workspace/projects/skill-atlas/logs/cloudflared.err.log
stdout_logfile_maxbytes=10MB
stderr_logfile_maxbytes=10MB
stdout_logfile_backups=3
stderr_logfile_backups=3
